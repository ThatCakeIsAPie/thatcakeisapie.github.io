---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { label, items, firstNote, closing } = site.faleth.steps;
const numerals = ['I', 'II', 'III', 'IV', 'V'];
---

<section class="steps" aria-labelledby="steps-h">
	<div class="wrap slab glass glass--reading">
		<SectionHeading label={label} id="steps-h" />
		<ol class="path steps__path">
			{
				items.map((t, i) => (
					<li class="path__item reveal">
						<span class:list={['node', i === items.length - 1 && 'node--filled']} aria-hidden="true">
							{numerals[i]}
						</span>
						<div class="step__body">
							<p class="step">{t}</p>
							{i === 0 && (
								<p class="step__note">
									<a href={firstNote.href}>{firstNote.linkLabel}</a>
									{firstNote.rest}
								</p>
							)}
						</div>
					</li>
				))
			}
		</ol>
		<p class="steps__closing reveal">{closing}</p>
	</div>
</section>

<style>
	.steps {
		margin-bottom: var(--panel-gap);
	}
	.steps__path {
		--node: clamp(3rem, 5vw, 3.75rem);
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
	}
	.path__item {
		align-items: start;
		column-gap: clamp(1.25rem, 3vw, 2.5rem);
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}
	.path__item:last-child {
		padding-bottom: 0;
	}
	.step__body {
		min-width: 0;
	}
	/* Visually secondary note attached to step I. */
	.step__note {
		max-width: 44ch;
		margin-top: 0.6rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-dim);
	}
	.step__note a {
		color: var(--gold-light);
		border-bottom: 1px solid var(--gold-deep);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.step__note a:hover {
		color: var(--text-bright);
		border-color: var(--gold-light);
	}
	.step {
		max-width: 34ch;
		padding-top: max(0px, calc((var(--node) - 1.3em) / 2));
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.15rem, 2.3vw, 1.75rem);
		line-height: 1.3;
		letter-spacing: 0.02em;
		color: var(--text-bright);
		text-wrap: balance;
	}
	.steps__closing {
		max-width: 40rem;
		margin: clamp(2.5rem, 5vw, 4rem) auto 0;
		padding-top: clamp(1.75rem, 3vw, 2.5rem);
		border-top: 1px solid var(--gold-deep);
		text-align: center;
		color: var(--text);
		text-wrap: balance;
	}
	@media (max-width: 480px) {
		.steps__path {
			--node: 2.75rem;
		}
	}
</style>
