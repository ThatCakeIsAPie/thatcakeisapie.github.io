---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { label, items } = site.faleth.buckets;
---

<section class="buckets" aria-labelledby="buckets-h">
	<div class="wrap slab glass glass--reading buckets__panel">
		<SectionHeading label={label} id="buckets-h" />
		<ul class="buckets__list">
			{
				items.map((b) => (
					<li class="bucket reveal">
						<h3 class="bucket__title">{b.title}</h3>
						<p class="bucket__text">{b.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.buckets {
		margin-bottom: var(--panel-gap);
	}
	.buckets__panel {
		width: min(100% - 2 * var(--gutter), 56rem);
	}
	.buckets__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--gold-deep);
	}
	.bucket {
		padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2.6vw, 2.25rem) 0;
	}
	.bucket + .bucket {
		border-left: 1px solid var(--rule);
	}
	.bucket:first-child {
		padding-left: 0;
	}
	.bucket:last-child {
		padding-right: 0;
	}
	.bucket__title {
		margin-bottom: 0.9rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
		line-height: 1.2;
	}
	.bucket__text {
		color: var(--text-bright);
		text-wrap: pretty;
	}
	@media (max-width: 700px) {
		.buckets__list {
			grid-template-columns: minmax(0, 1fr);
		}
		.bucket,
		.bucket:first-child,
		.bucket:last-child {
			padding: 1.75rem 0;
		}
		.bucket + .bucket {
			border-left: 0;
			border-top: 1px solid var(--rule);
		}
		.bucket:last-child {
			padding-bottom: 0;
		}
	}
</style>
