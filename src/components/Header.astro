---
import { site } from '../content/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const is = (href: string) => (href.replace(/\/+$/, '') || '/') === path;
// A section tab also counts as current on the pages beneath it (e.g. /faleth/<document>/).
const inSection = (href: string) => is(href) || (href !== '/' && path.startsWith(href.replace(/\/+$/, '') + '/'));
const { name, left, right } = site.nav;
---

<header class="topbar glass glass--reading">
	<nav class="topbar__in wrap" aria-label="Primary">
		<a class="tab tab--left" href={left.href} aria-current={inSection(left.href) ? 'page' : undefined}>
			<span>{left.label}</span>
		</a>
		<a class="brand" href="/" aria-current={is('/') ? 'page' : undefined}>
			<span>{name}</span>
		</a>
		<a class="tab tab--right" href={right.href} aria-current={inSection(right.href) ? 'page' : undefined}>
			<span>{right.label}</span>
		</a>
	</nav>
</header>

<style>
	/* Always glass (reading recipe: it floats over the brightest part of the art). Only the bottom edge is drawn. */
	.topbar {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		height: var(--header-h);
		border-width: 0 0 1px;
		border-radius: 0;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.1),
			0 10px 30px rgba(0, 0, 0, 0.25);
	}
	.topbar__in {
		height: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		column-gap: 0.75rem;
	}

	.brand,
	.tab {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-display);
		font-weight: 600;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 0.2s ease;
	}
	/* Each tab is centred in its own 1fr column, i.e. halfway between the page edge and the name.
	   Extra left padding equals the trailing letter-spacing, so the glyphs (not the box) are centred. */
	.tab {
		font-size: 0.82rem;
		letter-spacing: 0.22em;
		color: var(--text);
		padding-inline: calc(0.25rem + 0.22em) 0.25rem;
	}
	.tab--left,
	.tab--right {
		justify-self: center;
	}
	.tab:hover {
		color: var(--gold-light);
	}
	.brand {
		font-size: 1.05rem;
		letter-spacing: 0.24em;
		color: var(--text-bright);
		padding-inline: calc(0.25rem + 0.24em) 0.25rem;
	}
	.brand:hover {
		color: var(--gold-light);
	}

	/* Active state: a gold rule under the current item */
	.tab::after,
	.brand::after {
		content: '';
		position: absolute;
		left: calc(0.25rem + 0.22em);
		right: calc(0.25rem + 0.22em);
		bottom: 0.15rem;
		height: 2px;
		background: var(--gold);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.brand::after {
		left: calc(0.25rem + 0.24em);
		right: calc(0.25rem + 0.24em);
	}
	[aria-current='page'] {
		color: var(--gold);
	}
	[aria-current='page']::after {
		transform: scaleX(1);
	}
	.tab:not([aria-current='page']):hover::after,
	.brand:not([aria-current='page']):hover::after {
		transform: scaleX(0.35);
	}

	@media (max-width: 520px) {
		.topbar__in {
			column-gap: 0.4rem;
		}
		.tab {
			font-size: 0.72rem;
			letter-spacing: 0.16em;
			padding-inline: calc(0.25rem + 0.16em) 0.25rem;
		}
		.tab::after {
			left: calc(0.25rem + 0.16em);
			right: calc(0.25rem + 0.16em);
		}
		.brand {
			font-size: 0.85rem;
			letter-spacing: 0.16em;
			padding-inline: calc(0.25rem + 0.16em) 0.25rem;
		}
		.brand::after {
			left: calc(0.25rem + 0.16em);
			right: calc(0.25rem + 0.16em);
		}
	}
</style>
