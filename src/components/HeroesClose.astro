---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { looking, closing } = site.heroes;
---

<section class="close" aria-labelledby="looking-h">
	<div class="wrap slab glass glass--reading looking reveal">
		<SectionHeading label={looking.label} id="looking-h" />
		<p class="looking__text">{looking.text}</p>
		<p class="looking__not">{looking.not}</p>
	</div>

	<div class="wrap slab glass glass--reading closing reveal">
		<p class="closing__text">{closing.text}</p>
		<a class="closing__link" href={closing.href}>{closing.linkLabel}</a>
	</div>
</section>

<style>
	.close {
		margin-bottom: var(--panel-gap);
	}
	.looking {
		display: grid;
		justify-items: center;
		text-align: center;
	}
	.looking :global(.sh) {
		width: 100%;
		margin-bottom: 2rem;
	}
	.looking__text {
		max-width: 40rem;
		font-size: 1.2rem;
		font-weight: 300;
		line-height: 1.7;
		text-wrap: balance;
	}
	.looking__not {
		max-width: 34rem;
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--text-dim);
		text-wrap: balance;
	}
	.closing {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 2.25rem;
		margin-top: var(--panel-gap);
	}
	.closing__text {
		max-width: 30ch;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.5rem, 3.4vw, 2.4rem);
		line-height: 1.3;
		letter-spacing: 0.03em;
		color: var(--text-bright);
		text-wrap: balance;
	}
	.closing__link {
		display: inline-block;
		padding: 0.85rem 1.9rem 0.75rem;
		border: 1px solid var(--gold);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.closing__link:hover {
		background: var(--gold);
		color: var(--bg-deepest);
	}
</style>
