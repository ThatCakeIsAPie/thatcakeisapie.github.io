---
import { site } from '../content/site';

interface Props {
	/** `bar`: the compact glass bar on the landing screen. `panel`: bare form for use inside an existing glass panel. */
	variant?: 'bar' | 'panel';
	/** Prefix for every id in this instance (inputs, labels, error ids). Must be unique per page. */
	idPrefix?: string;
}

const { id, label, form } = site.contact;
const { variant = 'bar', idPrefix = variant === 'bar' ? 'cf' : 'cfp' } = Astro.props;
const isBar = variant === 'bar';
const p = idPrefix;
const clientConfig = JSON.stringify({ endpoint: form.endpoint, siteKey: form.turnstileSiteKey, errors: form.errors, sending: form.sending, error: form.error, success: form.success });
---

<!-- The landing bar owns `#contact-form` (the phone anchor and other pages link to it); other instances get no such id. -->
<div class:list={['cbar', `cbar--${variant}`]} id={isBar ? `${id}-form` : undefined} data-contact-form data-config={clientConfig}>
	<div class:list={['cbar__bar', isBar && 'glass glass--reading']}>
		<form class="cbar__form" novalidate aria-labelledby={isBar ? `${p}-label` : undefined} aria-label={isBar ? undefined : label}>
			{isBar && <h2 class="cbar__label" id={`${p}-label`}>{label}</h2>}
			<div class="field field--name">
				<label class="sr" for={`${p}-name`}>{form.nameLabel}</label>
				<input id={`${p}-name`} name="name" type="text" autocomplete="name" placeholder={form.nameLabel} required maxlength="100" aria-describedby={`${p}-name-err`} />
			</div>
			<div class="field field--phone">
				<label class="sr" for={`${p}-phone`}>{form.phoneLabel}</label>
				<input id={`${p}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder={form.phoneLabel} required maxlength="40" aria-describedby={`${p}-phone-err`} />
			</div>
			<div class="field field--email">
				<label class="sr" for={`${p}-email`}>{form.emailLabel}</label>
				<input id={`${p}-email`} name="email" type="email" autocomplete="email" placeholder={form.emailLabel} maxlength="254" aria-describedby={`${p}-email-err`} />
			</div>
			<div class="hp" aria-hidden="true">
				<label>{form.honeypotLabel}<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
			</div>
			<div class="cbar__row2">
				<div class="field field--message">
					<label class="sr" for={`${p}-message`}>{form.messageLabel}</label>
					<input id={`${p}-message`} name="message" type="text" autocomplete="off" placeholder={form.messageLabel} required aria-required="true" maxlength="300" aria-describedby={`${p}-message-err`} />
				</div>
				<button class="cbar__send" type="submit">{form.button}</button>
			</div>
			<p class="cbar__note">{form.note}</p>
		</form>
		<p class="cbar__success" role="status" tabindex="-1" data-status></p>
		<noscript>
			<p class="cbar__note cbar__note--solo">{form.noscript}</p>
		</noscript>
	</div>

	<!-- Messages and the (interaction-only) Turnstile widget live directly under the form. -->
	<div class="cbar__msgs">
		<p class="cbar__err" id={`${p}-name-err`} data-err="name" hidden></p>
		<p class="cbar__err" id={`${p}-phone-err`} data-err="phone" hidden></p>
		<p class="cbar__err" id={`${p}-email-err`} data-err="email" hidden></p>
		<p class="cbar__err" id={`${p}-message-err`} data-err="message" hidden></p>
		<p class="cbar__err" role="alert" data-form-error hidden>{form.error}</p>
		<div class="cbar__ts" data-turnstile></div>
	</div>
</div>

<style>
	.cbar {
		position: relative;
		min-width: 0;
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.cbar__bar {
		--glass-radius: 20px;
		padding: clamp(0.6rem, 1.5svh, 0.9rem) clamp(1rem, 2vw, 1.5rem);
	}
	.cbar__form {
		display: grid;
		grid-template-columns: auto repeat(3, minmax(0, 1fr));
		align-items: center;
		column-gap: clamp(0.6rem, 1.2vw, 1rem);
		row-gap: 0.3rem;
	}
	/* Row 2: the free-text field takes the width, Send sits at the right end. */
	.cbar__row2 {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: clamp(0.6rem, 1.2vw, 1rem);
	}
	.field--message {
		flex: 1;
	}
	.cbar__send {
		flex: none;
	}
	.cbar__form[hidden] {
		display: none;
	}
	:global(html:not(.js)) .cbar__form {
		display: none;
	}
	.cbar__label {
		margin: 0;
		padding-right: clamp(0.25rem, 1vw, 1rem);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--gold);
	}
	.field {
		min-width: 0;
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.field input {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.5rem 0.85rem;
		font: inherit;
		font-size: 1rem;
		font-weight: 400;
		color: var(--text-bright);
		background: rgba(9, 18, 17, 0.5);
		border: 1px solid rgba(231, 220, 198, 0.45);
		border-radius: 0;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}
	.field input::placeholder {
		color: var(--text-dim);
		opacity: 1;
	}
	.field input:hover {
		border-color: rgba(231, 220, 198, 0.7);
	}
	.field input:focus {
		outline: 2px solid transparent; /* stays visible in forced-colors mode */
		border-color: var(--gold);
		background: rgba(9, 18, 17, 0.62);
		box-shadow: 0 0 0 3px rgba(227, 194, 113, 0.4);
	}
	.field input[aria-invalid='true'] {
		border-color: var(--rust);
	}
	.hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.cbar__send {
		min-height: 2.75rem;
		padding: 0.7rem 1.6rem 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
		background: transparent;
		border: 1px solid var(--gold);
		border-radius: 0;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.cbar__send:hover:not(:disabled) {
		background: var(--gold);
		color: var(--bg-deepest);
	}
	.cbar__send:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.cbar__note {
		grid-column: 1 / -1;
		font-size: 0.9rem;
		line-height: 1.35;
		color: var(--text-dim);
	}
	.cbar__note--solo {
		margin: 0;
	}
	.cbar__success {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.1rem, 1.8vw, 1.35rem);
		letter-spacing: 0.03em;
		line-height: 1.3;
		color: var(--text-bright);
		max-width: none;
	}
	.cbar__success:empty {
		display: none;
	}
	.cbar__success:focus {
		outline: none;
	}

	/* Messages: directly under the bar. Out of flow on desktop so showing them never moves the landing. */
	.cbar__msgs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 1.5rem;
		padding: 0 0.5rem;
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		right: 0;
		z-index: 2;
	}
	.cbar__msgs:not(:has(:not([hidden]):not(:empty))) {
		display: none;
	}
	.cbar__err {
		max-width: none;
		font-size: 0.95rem;
		line-height: 1.4;
		color: #ffb59c;
		text-shadow: 0 1px 8px rgba(9, 18, 17, 0.9);
	}
	.cbar__ts {
		flex-basis: 100%;
	}
	.cbar__ts:empty {
		display: none;
	}

	/* Stacked (tablet/phone): two inputs per row, messages in the flow. */
	@media (max-width: 900px) {
		.cbar__bar {
			--glass-radius: 18px;
			padding: 0.8rem 1rem 0.85rem;
		}
		.cbar__form {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.6rem;
			row-gap: 0.6rem;
		}
		.cbar__label {
			grid-column: 1 / -1;
			padding: 0;
		}
		.field--email,
		.cbar__row2 {
			grid-column: 1 / -1;
		}
		/* Phone: Name + Phone, then Email, then the message field, then Send full width. */
		.cbar__row2 {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 0.6rem;
		}
		/* Narrow phones: shrink the long placeholder just enough to show in full (about 301px of text at 16px). */
		.field--message input {
			padding-inline: 0.65rem;
			font-size: clamp(0.8rem, calc((100vw - 6.05rem) * 0.0532), 1rem);
		}
		.cbar__send {
			width: 100%;
			padding-inline: 0.75rem;
		}
		.cbar__note {
			grid-column: 1 / -1;
			margin-top: -0.1rem;
		}
		.cbar__msgs {
			position: static;
			padding: 0.5rem 0.25rem 0;
		}
	}

	/* ---- variant "panel": sits inside the section's own glass panel (no glass of its own, no label) ---- */
	.cbar--panel .cbar__bar {
		padding: 0;
	}
	/* Messages stay in the flow, under the form. */
	.cbar--panel .cbar__msgs {
		position: static;
		padding: 0.75rem 0 0;
	}
	/* Desktop: the panel sits in the left column of the contact section, so it stacks like the phone layout:
	   Name + Phone, Email, the message field, then Send full width. */
	@media (min-width: 901px) {
		.cbar--panel .cbar__form {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.75rem;
			row-gap: 0.75rem;
		}
		.cbar--panel .field--email,
		.cbar--panel .cbar__row2 {
			grid-column: 1 / -1;
		}
		.cbar--panel .cbar__row2 {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}
		.cbar--panel .cbar__send {
			width: 100%;
		}
		.cbar--panel .cbar__note {
			margin-top: 0.1rem;
		}
	}
	/* Phone: same stacking as the bar, but the panel has less side padding to lose than the bar, so the long
	   placeholder gets its own size curve (about 231px of text at 16px must fit inside the input: full size from ~345px wide). */
	@media (max-width: 900px) {
		.cbar--panel .cbar__form {
			row-gap: 0.6rem;
		}
		.cbar--panel .field--message input {
			font-size: clamp(0.8rem, calc((100vw - 7.6rem) * 0.0693), 1rem);
		}
		.cbar--panel .cbar__msgs {
			padding: 0.6rem 0 0;
		}
	}
</style>

<script>
	type Cfg = { endpoint: string; siteKey: string; errors: Record<string, string>; sending: string; error: string; success: string };
	type TS = {
		render: (el: HTMLElement, o: Record<string, unknown>) => string;
		reset: (id?: string) => void;
	};

	// Turnstile's API script is requested once per page, however many forms there are and whichever is focused first.
	let apiLoading: Promise<TS> | null = null;
	const ts = () => (window as unknown as { turnstile?: TS }).turnstile;
	function loadApi(): Promise<TS> {
		if (apiLoading) return apiLoading;
		apiLoading = new Promise<TS>((resolve, reject) => {
			const s = document.createElement('script');
			s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
			s.async = true;
			s.onload = () => {
				const t = ts();
				if (t) resolve(t);
				else reject(new Error('turnstile'));
			};
			s.onerror = () => reject(new Error('turnstile'));
			document.head.appendChild(s);
		});
		apiLoading.catch(() => (apiLoading = null)); // allow a retry on the next focus or submit
		return apiLoading;
	}

	// Each [data-contact-form] instance is independent: own state, timer, Turnstile widget and token, status swap.
	function init(root: HTMLElement) {
		const cfg: Cfg = JSON.parse(root.dataset.config || '{}');
		const form = root.querySelector<HTMLFormElement>('form')!;
		const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const box = root.querySelector<HTMLElement>('[data-turnstile]')!;
		const msgs = root.querySelector<HTMLElement>('.cbar__msgs')!;
		const formError = root.querySelector<HTMLElement>('[data-form-error]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const idleLabel = button.textContent ?? '';
		const fields = ['name', 'phone', 'email', 'message'] as const;
		type Field = (typeof fields)[number];
		const input = (f: Field) => form.elements.namedItem(f) as HTMLInputElement;
		const errEl = (f: Field) => root.querySelector<HTMLElement>(`[data-err=${f}]`)!;
		// Messages sit under the bar, which on a short desktop viewport can be the very bottom edge: bring them into view.
		const reveal = () => requestAnimationFrame(() => msgs.getBoundingClientRect().height && msgs.scrollIntoView({ block: 'nearest', behavior: 'smooth' }));

		// Same rules as worker/src/validate.ts (the server is authoritative).
		const CONTROL = /[\u0000-\u001F\u007F-\u009F\u2028\u2029]/g;
		const BIDI = /[\u202A-\u202E\u2066-\u2069]/g;
		const clean = (v: string) => v.replace(CONTROL, '').replace(BIDI, '').trim();
		// Free text: newlines/tabs become one space, like the server.
		const cleanLine = (v: string) => clean(v.replace(/[\t\n\v\f\r\u0085\u2028\u2029]+/g, ' ').replace(/ {2,}/g, ' '));
		function check(f: Field): string | null {
			const v = f === 'message' ? cleanLine(input(f).value) : clean(input(f).value);
			if (f === 'name') {
				if (!v) return 'name_required';
				if ([...v].length > 100) return 'name_too_long';
			} else if (f === 'phone') {
				if (!v) return 'phone_required';
				if (v.length > 40 || !/^\+?\d{7,15}$/.test(v.replace(/[\s\-.()]/g, ''))) return 'phone_invalid';
			} else if (f === 'message') {
				if (!v) return 'message_required';
				if ([...v].length > 300) return 'invalid_message';
			} else if (v) {
				if (v.length > 254) return 'email_too_long';
				if (!/^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/.test(v)) return 'email_invalid';
			}
			return null;
		}
		function show(f: Field, code: string | null) {
			const el = errEl(f);
			el.textContent = code ? (cfg.errors[code] ?? cfg.error) : '';
			el.hidden = !code;
			if (code) input(f).setAttribute('aria-invalid', 'true');
			else input(f).removeAttribute('aria-invalid');
		}

		// Turnstile: loaded on first focus only, so the page makes no third-party request until the visitor engages.
		// appearance 'interaction-only': no visible widget unless Cloudflare needs the visitor to act (it then shows under the bar).
		let startedAt = 0;
		let loading: Promise<void> | null = null;
		let widgetId: string | undefined;
		let token = '';
		let waiter: ((t: string) => void) | null = null;
		// This instance's widget: rendered once the (shared) API script is there.
		function loadTurnstile(): Promise<void> {
			if (loading) return loading;
			if (!startedAt) startedAt = Date.now();
			loading = loadApi().then((t) => {
				widgetId = t.render(box, {
					sitekey: cfg.siteKey,
					action: 'contact',
					theme: 'dark',
					appearance: 'interaction-only',
					callback: (t2: string) => {
						token = t2;
						waiter?.(t2);
						waiter = null;
					},
					'expired-callback': () => {
						token = '';
					},
					'error-callback': () => {
						token = '';
					},
				});
			});
			loading.catch(() => (loading = null)); // allow a retry on the next focus or submit
			return loading;
		}
		form.addEventListener('focusin', () => void loadTurnstile().catch(() => {}), { once: true });

		function nextToken(): Promise<string> {
			if (token) return Promise.resolve(token);
			return new Promise((resolve, reject) => {
				waiter = resolve;
				setTimeout(() => reject(new Error('timeout')), 20000);
			});
		}

		function fail() {
			formError.hidden = false;
			reveal();
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			formError.hidden = true;
			let firstBad: Field | null = null;
			for (const f of fields) {
				const code = check(f);
				show(f, code);
				if (code && !firstBad) firstBad = f;
			}
			if (firstBad) {
				reveal();
				return input(firstBad).focus({ preventScroll: true });
			}

			button.disabled = true;
			button.textContent = cfg.sending;
			form.setAttribute('aria-busy', 'true');
			let ok = false;
			try {
				await loadTurnstile();
				const t = await nextToken();
				const message = cleanLine(input('message').value);
				const body = {
					name: clean(input('name').value),
					phone: clean(input('phone').value),
					email: clean(input('email').value),
					message,
					company: (form.elements.namedItem('company') as HTMLInputElement).value,
					token: t,
					elapsedMs: Date.now() - startedAt,
				};
				const res = await fetch(cfg.endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body),
				});
				const data = await res.json().catch(() => ({}));
				if (res.ok && data.ok) ok = true;
				else if (data.field && fields.includes(data.field)) {
					show(data.field as Field, data.error);
					input(data.field as Field).focus({ preventScroll: true });
					reveal();
				} else fail();
			} catch {
				fail();
			}
			if (ok) {
				status.textContent = cfg.success;
				form.hidden = true;
				msgs.hidden = true;
				status.focus();
			} else {
				// Tokens are single-use: get a fresh one for the retry.
				token = '';
				if (widgetId !== undefined) ts()?.reset(widgetId);
				button.disabled = false;
				button.textContent = idleLabel;
			}
			form.removeAttribute('aria-busy');
		});

		for (const f of fields) input(f).addEventListener('input', () => errEl(f).hidden || show(f, null));
	}
	document.querySelectorAll<HTMLElement>('[data-contact-form]').forEach(init);
</script>
