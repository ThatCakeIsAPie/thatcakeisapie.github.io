---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const h = site.heroes;
---

<section class="intro" aria-labelledby="journey-title">
	<div class="wrap slab glass glass--reading intro__panel">
		<SectionHeading label={h.label} title={h.heading} intro={h.intro} id="journey-title" h1 />
	</div>
</section>

<style>
	.intro {
		padding-top: calc(var(--header-h) + var(--panel-gap));
		margin-bottom: var(--panel-gap);
	}
	/* The header panel is just the title and one paragraph: narrower than the other panels, generous padding, no trailing gap. */
	.intro__panel {
		width: min(100% - 2 * var(--gutter), 56rem);
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}
	.intro :global(.sh) {
		margin-bottom: 0;
		gap: clamp(1.25rem, 2.5vw, 2rem);
	}
	.intro :global(.sh__intro) {
		max-width: 38rem;
		font-weight: 300;
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		line-height: 1.6;
	}
</style>
