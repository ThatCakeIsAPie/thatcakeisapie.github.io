---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const h = site.heroes;
---

<section class="intro" aria-labelledby="heroes-title">
	<div class="wrap slab glass glass--reading intro__panel">
		<SectionHeading label={h.label} title={h.heading} intro={h.intro} id="heroes-title" h1 />
	</div>
</section>

<style>
	.intro {
		padding-top: calc(var(--header-h) + var(--panel-gap));
		margin-bottom: var(--panel-gap);
	}
	/* Compact title panel so the WHY statement lands in the first desktop viewport. */
	.intro__panel {
		width: min(100% - 2 * var(--gutter), 56rem);
		padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
	}
	.intro :global(.sh) {
		margin-bottom: 0;
		gap: clamp(0.9rem, 1.6vw, 1.25rem);
	}
	.intro :global(.sh__intro) {
		font-weight: 300;
		font-size: 1.05rem;
		letter-spacing: 0.04em;
		color: var(--text-dim);
	}
</style>
