---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { name, rules } = site.heroes;
---

<div class="found">
	<div class="found__grid">
		<section class="slab glass glass--reading found__name reveal" aria-labelledby="name-h">
			<SectionHeading label={name.label} id="name-h" />
			<p class="found__text">{name.text}</p>
		</section>

		<section class="slab glass glass--reading found__rules" aria-labelledby="rules-h">
			<SectionHeading label={rules.label} id="rules-h" />
			<ul class="rules">
				{
					rules.items.map((r) => (
						<li class="rule reveal">
							<h3 class="rule__title">{r.title}</h3>
							<p class="rule__text">{r.text}</p>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</div>

<style>
	.found {
		margin-bottom: var(--panel-gap);
	}
	.found__grid {
		width: min(100% - 2 * var(--gutter), var(--wrap));
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: var(--panel-gap);
		align-items: stretch;
	}
	.found__name {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.found :global(.sh) {
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}
	/* Quieter than the blocks above: body-size type, no display sizes. */
	.found__text {
		font-weight: 300;
		font-size: clamp(1.1rem, 1.6vw, 1.3rem);
		line-height: 1.7;
		text-align: center;
		text-wrap: balance;
	}
	.rules {
		display: grid;
	}
	.rule {
		padding: 1.5rem 0;
		border-top: 1px solid var(--rule);
	}
	.rule:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.rule:last-child {
		padding-bottom: 0;
	}
	.rule__title {
		margin-bottom: 0.5rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.98rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		line-height: 1.3;
		color: var(--gold);
	}
	.rule__text {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-dim);
	}
	@media (max-width: 960px) {
		.found__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
