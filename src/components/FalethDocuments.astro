---
import { getCollection } from 'astro:content';
import { site } from '../content/site';
import { formatUpdated } from '../lib/canon-dates';
import SectionHeading from './SectionHeading.astro';

const { label, text, updated } = site.faleth.documents;
const docs = (await getCollection('canon')).sort((a, b) => a.data.order - b.data.order);
const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
---

<section class="docs" aria-labelledby="docs-h">
	<div class="wrap slab glass glass--reading docs__panel">
		<SectionHeading label={label} id="docs-h" />
		<p class="docs__intro reveal">{text}</p>
		<ol class="docs__list">
			{
				docs.map((d, i) => (
					<li class="doc reveal">
						<span class="doc__no" aria-hidden="true">{numerals[i] ?? i + 1}</span>
						<div class="doc__main">
							<a class="doc__title" href={`/faleth/${d.id}/`}>
								{d.data.title}
							</a>
							{d.data.tagline && <p class="doc__tagline">{d.data.tagline}</p>}
						</div>
						{d.data.updated && (
							<p class="doc__date">
								{updated} <time datetime={d.data.updated}>{formatUpdated(d.data.updated)}</time>
							</p>
						)}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.docs {
		margin-bottom: var(--panel-gap);
	}
	.docs__panel {
		width: min(100% - 2 * var(--gutter), 56rem);
	}
	.docs__intro {
		max-width: 44rem;
		margin: 0 auto clamp(2rem, 4vw, 3rem);
		text-align: center;
		font-size: 1.2rem;
		font-weight: 300;
		line-height: 1.7;
		text-wrap: balance;
	}
	.docs__list {
		border-top: 1px solid var(--gold-deep);
	}
	.doc {
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr) auto;
		column-gap: 1rem;
		align-items: baseline;
		padding-block: 1.35rem;
		border-bottom: 1px solid var(--rule);
	}
	.doc:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.doc__no {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.1rem;
		letter-spacing: 0.06em;
		color: var(--gold);
	}
	.doc__title {
		display: inline;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		letter-spacing: 0.06em;
		line-height: 1.3;
		color: var(--text-bright);
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.doc__title:hover {
		color: var(--gold-light);
		border-color: var(--gold-deep);
	}
	.doc__tagline {
		margin-top: 0.35rem;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--text-dim);
		text-wrap: pretty;
	}
	.doc__date {
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.doc {
			grid-template-columns: 2.5rem minmax(0, 1fr);
		}
		.doc__date {
			grid-column: 2;
			margin-top: 0.4rem;
		}
	}
</style>
