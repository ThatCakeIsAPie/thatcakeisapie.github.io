---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mark from './Mark.astro';

interface Props {
	photo: ImageMetadata | null;
	alt: string;
	label: string;
}
const { photo, alt, label } = Astro.props;
---

<div class="frame glass">
	{
		photo ? (
			<Image
				src={photo}
				alt={alt}
				widths={[320, 480, 640]}
				sizes="(max-width: 720px) 14rem, 22rem"
				loading="eager"
			/>
		) : (
			<div class="placeholder" role="img" aria-label="Portrait placeholder">
				<Mark class="placeholder__mark" />
				<span class="placeholder__label">{label}</span>
			</div>
		)
	}
</div>

<style>
	.frame {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		/* Liquid glass (see .glass in global.css): the art shows through, blurred. The arch is kept. */
		--glass-radius: 50% 50% 0 0 / 40% 40% 0 0;
		border-color: var(--gold);
		overflow: hidden;
	}
	/* inner hairline, like a window frame */
	.frame::after {
		content: '';
		position: absolute;
		inset: 7px;
		border: 1px solid var(--line);
		border-radius: 50% 50% 0 0 / 40% 40% 0 0;
		pointer-events: none;
	}
	.frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
	}
	.placeholder :global(.placeholder__mark) {
		height: 44%;
		color: rgba(227, 194, 113, 0.26);
		margin-top: -4%;
	}
	.placeholder__label {
		position: absolute;
		bottom: 11%;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.32em;
		text-indent: 0.32em;
		text-transform: uppercase;
		color: var(--gold-light);
		text-shadow: 0 1px 8px rgba(9, 18, 17, 0.6);
	}
</style>
