---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { rules } = site.heroes;
---

<section class="found" aria-labelledby="rules-h">
	<div class="wrap slab glass glass--reading">
		<SectionHeading label={rules.label} id="rules-h" />
		<ul class="rules">
			{
				rules.items.map((r) => (
					<li class="rule reveal">
						<h3 class="rule__title">{r.title}</h3>
						<p class="rule__text">{r.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.found {
		margin-bottom: var(--panel-gap);
	}
	.found :global(.sh) {
		margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
	}
	/* Quieter than the blocks above: body-size type, three ruled columns. */
	.rules {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--rule);
	}
	.rule {
		padding: 1.75rem clamp(1.25rem, 2.5vw, 2.5rem) 0;
	}
	.rule:first-child {
		padding-left: 0;
	}
	.rule:last-child {
		padding-right: 0;
	}
	.rule + .rule {
		border-left: 1px solid var(--rule);
	}
	.rule__title {
		margin-bottom: 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.98rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		line-height: 1.4;
		color: var(--gold);
	}
	.rule__text {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--text-dim);
	}
	@media (max-width: 800px) {
		.rules {
			grid-template-columns: minmax(0, 1fr);
		}
		.rule,
		.rule:first-child,
		.rule:last-child {
			padding: 1.5rem 0 0;
		}
		.rule:first-child {
			padding-top: 1.5rem;
		}
		.rule + .rule {
			border-left: 0;
			border-top: 1px solid var(--rule);
			margin-top: 1.5rem;
		}
	}
</style>
