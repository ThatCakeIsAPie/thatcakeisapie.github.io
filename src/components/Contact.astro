---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon.astro';
import ContactForm from './ContactForm.astro';

const { id, label, heading, text } = site.contact;
// Featured platforms (e.g. the one I'm most active on) are listed first; the rest keep their order.
const socials = [...site.socials].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---

<section class="contact" id={id} aria-labelledby={`${id}-h`}>
	<div class="wrap slab glass glass--reading">
		<SectionHeading label={label} id={`${id}-h`} />
		<div class="contact__body">
			<div class="contact__main">
				<div class="lede reveal">
					{heading && <p class="lede__heading">{heading}</p>}
					<p class="lede__text">{text}</p>
				</div>
				<div class="contact__form reveal">
					<ContactForm variant="panel" idPrefix="cfp" />
				</div>
			</div>
			<ul class="links reveal">
			{
				socials.map((s) => (
					<li>
						<a class="link" href={s.href} rel="noopener">
							<SocialIcon id={s.id} />
							<span class="link__name">
								{s.name}
								{s.featured && s.featuredLabel && <span class="tag link__tag">{s.featuredLabel}</span>}
							</span>
							<span class="link__handle">{s.handle}</span>
							<svg class="link__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					</li>
				))
			}
			</ul>
		</div>
	</div>
</section>

<style>
	.contact {
		margin-bottom: var(--panel-gap);
	}
	/* Desktop: paragraph and form on the left, the platform list on the right. One column below 901px. */
	.contact__body {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(3rem, 8vw, 7rem);
		align-items: start;
	}
	.contact__main {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.25rem);
		min-width: 0;
	}
	.contact__form {
		min-width: 0;
	}
	@media (max-width: 900px) {
		.contact__body {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
		}
	}
	.lede__heading {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.7rem, 3vw, 2.4rem);
		line-height: 1.25;
		letter-spacing: 0.03em;
		color: var(--text-bright);
		text-wrap: balance;
		margin-bottom: 1.5rem;
	}
	.lede__text {
		font-size: 1.2rem;
		font-weight: 300;
	}
	.links {
		border-top: 1px solid var(--gold-deep);
	}
	.links li {
		border-bottom: 1px solid var(--rule);
	}
	.link {
		display: grid;
		grid-template-columns: 1.6rem 1fr auto 1.5rem;
		align-items: center;
		column-gap: 1.1rem;
		min-height: 4.75rem;
		padding-inline: 0.25rem 0.5rem;
		transition:
			background-color 0.2s ease,
			padding 0.2s ease;
	}
	.link :global(.social-icon) {
		width: 1.5rem;
		height: 1.5rem;
		color: var(--gold);
	}
	.link__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.15rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-bright);
		transition: color 0.2s ease;
	}
	/* The boxed tag sits beside the name and stays on the same line as it. */
	.link__tag {
		margin-left: 0.75rem;
		vertical-align: 0.1em;
		letter-spacing: 0.16em;
	}
	.link__handle {
		color: var(--text-dim);
		font-size: 1rem;
		text-align: right;
		overflow-wrap: anywhere;
	}
	.link__arrow {
		width: 1.4rem;
		height: 1.4rem;
		color: var(--gold);
		transition: transform 0.2s ease;
	}
	.link:hover {
		background: var(--glass-hover);
		padding-inline: 0.9rem;
	}
	.link:hover .link__name {
		color: var(--gold-light);
	}
	.link:hover .link__arrow {
		transform: translateX(4px);
	}
	@media (max-width: 480px) {
		.link {
			grid-template-columns: 1.5rem 1fr 1.25rem;
			row-gap: 0;
			padding-block: 0.8rem;
		}
		.link__handle {
			grid-column: 2;
			grid-row: 2;
			text-align: left;
			font-size: 0.95rem;
		}
		.link__arrow {
			grid-column: 3;
			grid-row: 1 / span 2;
		}
		.link :global(.social-icon) {
			grid-row: 1 / span 2;
		}
	}
</style>

