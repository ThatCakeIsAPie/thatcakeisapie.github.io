---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Personal website of Lyle Cole.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--bg: #fbfaf8;
		--text: #1c1b19;
		--muted: #6b6860;
		--accent: #b4521e;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #161514;
			--text: #ece9e3;
			--muted: #9a968c;
			--accent: #f0935c;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	main {
		max-width: 40rem;
		margin: 0 auto;
		padding: 18vh 1.25rem 4rem;
	}

	h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2.25rem, 7vw, 3.25rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	p {
		margin: 0 0 1rem;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.2em;
	}

	.muted {
		color: var(--muted);
	}
</style>
