---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { looking } = site.heroes;
---

<section class="close" aria-labelledby="looking-h">
	<div class="wrap slab glass glass--reading looking reveal">
		<SectionHeading label={looking.label} id="looking-h" />
		<p class="looking__text">{looking.text}</p>
		<p class="looking__not">{looking.not}</p>
	</div>
</section>

<style>
	.close {
		margin-bottom: var(--panel-gap);
	}
	.looking {
		display: grid;
		justify-items: center;
		text-align: center;
	}
	.looking :global(.sh) {
		width: 100%;
		margin-bottom: 2rem;
	}
	.looking__text {
		max-width: 40rem;
		font-size: 1.2rem;
		font-weight: 300;
		line-height: 1.7;
		text-wrap: balance;
	}
	.looking__not {
		max-width: 34rem;
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--text-dim);
		text-wrap: balance;
	}
</style>
