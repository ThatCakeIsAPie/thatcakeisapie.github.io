---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';

const { label, lines } = site.heroes.code;
const numerals = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---

<section class="code" aria-labelledby="code-h">
	<div class="wrap slab slab--code glass glass--reading">
		<SectionHeading label={label} id="code-h" />
		<ol class="path code__list">
			{
				lines.map((l, i) => (
					<li class="path__item reveal">
						<span class:list={['node', i === lines.length - 1 && 'node--filled']} aria-hidden="true">
							{numerals[i]}
						</span>
						<p class="line">{l}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.code {
		margin-bottom: var(--panel-gap);
	}
	/* THE CODE is the page's strongest moment: the roomiest panel, with a gold hairline. */
	.slab--code {
		padding-block: clamp(3rem, 8vw, 6.5rem);
		border-color: rgba(227, 194, 113, 0.35);
	}
	.code :global(.sh) {
		margin-bottom: clamp(3.5rem, 8vw, 6.5rem);
	}
	.code__list {
		--node: clamp(3rem, 6vw, 4.75rem);
		width: fit-content;
		max-width: 100%;
		margin-inline: auto;
	}
	/* Nodes sit on the first line of each statement (not centred on the block), so the dotted connector
	   never runs through a wrapped line's numeral. --lb is one line box of the statement. */
	.code__list {
		--fs: clamp(1.7rem, 5.2vw, 4.25rem);
		--lb: calc(var(--fs) * 1.12);
		--lead: max(0px, calc((var(--lb) - var(--node)) / 2));
	}
	.path__item {
		column-gap: clamp(1.25rem, 3.5vw, 3rem);
		padding-bottom: clamp(2.75rem, 6vw, 4.75rem);
		align-items: start;
	}
	.path__item:not(:last-child)::before {
		top: calc(var(--lead) + var(--node) + 0.45rem);
	}
	.path__item:last-child {
		padding-bottom: 0;
	}
	.node {
		margin-top: var(--lead);
		font-size: clamp(0.95rem, 1.7vw, 1.3rem);
	}
	.line {
		max-width: none;
		font-family: var(--font-display);
		font-weight: 500;
		padding-top: max(0px, calc((var(--node) - var(--lb)) / 2));
		font-size: var(--fs);
		line-height: 1.12;
		letter-spacing: 0.03em;
		color: var(--text-bright);
		text-wrap: balance;
	}
	@media (max-width: 480px) {
		.code__list {
			--node: 2.75rem;
		}
		.path__item {
			column-gap: 1rem;
		}
	}
</style>
